---
import type { Note } from '../lib/notes';
import { formatDate, isoDate } from '../lib/notes';

interface Props {
  notes: Note[];
  /** Message shown when there is nothing to list yet. */
  emptyLabel?: string;
  emptyText?: string;
  showTags?: boolean;
}
const {
  notes,
  emptyLabel = 'No entries yet',
  emptyText = 'First note is being written. Check back, or follow along on GitHub.',
  showTags = true,
} = Astro.props;
---

{
  notes.length === 0 ? (
    <div class="empty">
      <span class="lbl">{emptyLabel}</span>
      <p>{emptyText}</p>
    </div>
  ) : (
    <div>
      {notes.map((note) => (
        <a class="entry" href={`/notes/${note.id}/`}>
          <time class="dt" datetime={isoDate(note.data.date)}>
            {formatDate(note.data.date)}
          </time>
          <div>
            <span class="ti">{note.data.title}</span>
            {note.data.summary && <span class="sum mute">{note.data.summary}</span>}
          </div>
          {showTags && note.data.tags.length > 0 && (
            <span class="tags">{note.data.tags.slice(0, 3).join(' · ')}</span>
          )}
        </a>
      ))}
    </div>
  )
}

<style>
  .sum {
    display: block;
    font-size: 13.5px;
  }
</style>
