---
import type { Note } from '../lib/notes';
import SectionHead from './SectionHead.astro';

interface Props {
  outbound: Note[];
  backlinks: Note[];
  related: Note[];
}
const { outbound, backlinks, related } = Astro.props;

const groups = [
  {
    key: 'out',
    title: 'Links out',
    hint: 'Notes this one points at.',
    notes: outbound,
  },
  {
    key: 'in',
    title: 'Linked from',
    hint: 'Notes that point back here.',
    notes: backlinks,
  },
  {
    key: 'rel',
    title: 'Related by tag',
    hint: 'Not linked, but sharing vocabulary.',
    notes: related,
  },
].filter((g) => g.notes.length > 0);
---

{
  groups.length > 0 && (
    <div class="panel mt">
      <SectionHead title="Connections" count={`${groups.reduce((n, g) => n + g.notes.length, 0)} LINKED`} />
      <div class="grid g3">
        {groups.map((group) => (
          <div>
            <span class="lbl">{group.title}</span>
            <p class="hint">{group.hint}</p>
            <ul>
              {group.notes.map((note) => (
                <li>
                  <a href={`/notes/${note.id}/`}>{note.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  )
}

<style>
  .hint {
    font-size: 12px;
    color: var(--faint);
    margin: 4px 0 8px;
  }
  ul {
    list-style: none;
    margin: 0;
  }
  li {
    border-top: 1px solid var(--line);
    padding: 7px 0;
    font-size: 14px;
  }
  li a {
    display: block;
  }
  li a:hover {
    color: var(--cyan);
  }
</style>
